---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL;
---

<StarlightPage
    frontmatter={{
        title: "Page not found",
        description: "The page you're looking for doesn't exist on the zulip-embed docs.",
        template: "splash",
        hero: {
            title: "Page not found",
            tagline:
                "The page you were looking for isn't here. It may have moved, been renamed, or never existed.",
        },
    }}
>
    <div class="nf">
        <p class="nf-lede">
            If you followed a link from an older README or external
            site, the doc you want is probably one of these:
        </p>

        <div class="nf-grid">
            <a class="nf-card" href={`${base}guides/quickstart/`}>
                <strong>Quickstart →</strong>
                <span
                    >Drop a <code>&lt;zulip-chat&gt;</code> into any HTML page
                    in under a minute.</span
                >
            </a>
            <a class="nf-card" href={`${base}guides/auth/`}>
                <strong>Auth (JWT) →</strong>
                <span>Short-lived tokens, the JWT handoff, backend minters.</span>
            </a>
            <a class="nf-card" href={`${base}reference/events/`}>
                <strong>Events reference →</strong>
                <span>Every <code>CustomEvent</code>, detail shape, fire timing.</span>
            </a>
            <a class="nf-card" href={`${base}reference/theming/`}>
                <strong>Theming reference →</strong>
                <span
                    >Every <code>--zc-*</code> custom property and theming attribute.</span
                >
            </a>
            <a class="nf-card" href={`${base}reference/agents/`}>
                <strong>Agents & AI →</strong>
                <span
                    ><code>startAgentReply</code>, <code>MessagePart</code>, confirmation
                    widgets.</span
                >
            </a>
            <a class="nf-card" href={`${base}playground/`}>
                <strong>Playground →</strong>
                <span>Tune every CSS token live and copy the snippet.</span>
            </a>
        </div>

        <p class="nf-fallback">
            Can't find what you need? Try the search box at the top of
            any page, or <a
                href="https://github.com/amanagr/zulip-embed/issues/new"
                >open an issue</a
            >
            on GitHub.
        </p>

        <p class="nf-home">
            <a href={base}>← Back to the docs home</a>
        </p>
    </div>
</StarlightPage>

<style>
    .nf {
        max-width: 48rem;
        margin: 0 auto;
        padding: 1.5rem 0;
    }
    .nf-lede {
        font-size: 1rem;
        color: var(--sl-color-text-accent);
        margin-bottom: 1.5rem;
    }
    .nf-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0.75rem;
        margin: 0 0 2rem;
    }
    .nf-card {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: 0.5rem;
        background: var(--sl-color-bg-sidebar);
        color: inherit;
        text-decoration: none;
        transition: border-color 120ms ease, transform 120ms ease;
    }
    .nf-card:hover {
        border-color: var(--sl-color-accent);
        transform: translateY(-1px);
    }
    .nf-card strong {
        color: var(--sl-color-accent);
        font-weight: 600;
    }
    .nf-card span {
        font-size: 0.85rem;
        color: var(--sl-color-text-accent);
        line-height: 1.45;
    }
    .nf-card code {
        font-size: 0.8em;
    }
    .nf-fallback,
    .nf-home {
        color: var(--sl-color-text-accent);
        font-size: 0.95rem;
    }
    .nf-home {
        margin-top: 1.5rem;
    }
</style>
