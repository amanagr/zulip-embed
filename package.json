{
  "name": "@zulip/embed",
  "version": "0.2.0",
  "description": "Embed Zulip chat as a framework-agnostic Web Component or headless SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/zulip-embed.js",
  "module": "./dist/zulip-embed.js",
  "types": "./dist/zulip-embed.d.ts",
  "unpkg": "./dist/zulip-embed.iife.js",
  "exports": {
    ".": {
      "types": "./dist/zulip-embed.d.ts",
      "import": "./dist/zulip-embed.js"
    },
    "./element": {
      "types": "./dist/zulip-embed.d.ts",
      "import": "./dist/zulip-embed.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && cross-env VITE_MODE=site vite build",
    "preview:site": "vite preview --outDir site --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "prettier": "~3.5.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "zulip",
    "chat",
    "embed",
    "web-component",
    "sdk",
    "messaging"
  ],
  "packageManager": "pnpm@10.0.0"
}
