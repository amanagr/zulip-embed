{
  "name": "zulip-embed",
  "version": "1.0.0",
  "description": "Embed Zulip chat as a framework-agnostic Web Component or headless SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/zulip-embed.js",
  "module": "./dist/zulip-embed.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/zulip-embed.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zulip-embed.js"
    },
    "./all": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zulip-embed.js"
    },
    "./chat": {
      "types": "./dist/entries/chat.d.ts",
      "import": "./dist/entries/chat.js"
    },
    "./channel-list": {
      "types": "./dist/entries/channel-list.d.ts",
      "import": "./dist/entries/channel-list.js"
    },
    "./dm-list": {
      "types": "./dist/entries/dm-list.d.ts",
      "import": "./dist/entries/dm-list.js"
    },
    "./topic-list": {
      "types": "./dist/entries/topic-list.d.ts",
      "import": "./dist/entries/topic-list.js"
    },
    "./agent": {
      "types": "./dist/entries/agent.d.ts",
      "import": "./dist/entries/agent.js"
    },
    "./announcement": {
      "types": "./dist/entries/announcement.d.ts",
      "import": "./dist/entries/announcement.js"
    },
    "./demo": {
      "types": "./dist/entries/demo.d.ts",
      "import": "./dist/entries/demo.js"
    },
    "./element": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zulip-embed.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cross-env VITE_FORMAT=iife vite build",
    "build:site": "tsc --noEmit && cross-env VITE_MODE=site vite build",
    "preview:site": "vite preview --outDir site --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/bundle-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "prettier": "~3.5.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "zulip",
    "chat",
    "embed",
    "web-component",
    "sdk",
    "messaging"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.0.0"
}
