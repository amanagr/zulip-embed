{
  "name": "zulip-embed-react",
  "version": "1.0.0",
  "description": "React wrapper for the Zulip Embed Web Component.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "zulip-embed": ">=1.0.0",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.15",
    "zulip-embed": "workspace:*",
    "jsdom": "^25.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~5.9.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "zulip",
    "chat",
    "react",
    "embed",
    "web-component"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
